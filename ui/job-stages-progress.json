{
  "schema_version": 1,
  "description": "Maps job.stage (from GET /jobs/{id}) to expected progress. Take the stage id as the substring before the first space (ignore optional human suffix such as (3/27) after a space).",
  "stage_id_rule": "const base = (job.stage ?? '').split(' ')[0];",
  "stages": [
    {
      "id": "starting",
      "progress": { "min": 5, "max": 5, "typical": 5 },
      "label": "Preparing job"
    },
    {
      "id": "phase_0_quality_filter",
      "progress": { "min": 8, "max": 8, "typical": 8 },
      "label": "Capture quality filtering"
    },
    {
      "id": "phase_1_segmentation",
      "progress": { "min": 10, "max": 40, "typical": 25 },
      "label": "Segmentation (SAM)",
      "note": "API may send full stage as \"phase_1_segmentation (i/total)\" while progress sweeps 10..40."
    },
    {
      "id": "phase_2_alignment",
      "progress": { "min": 40, "max": 60, "typical": 45 },
      "label": "Metric reconstruction (MapAnything)"
    },
    {
      "id": "phase_3_sanitization",
      "progress": { "min": 55, "max": 70, "typical": 65 },
      "label": "Point cloud cleaning"
    },
    {
      "id": "phase_4_colmap_bridge",
      "progress": { "min": 60, "max": 60, "typical": 60 },
      "label": "Sparse text for GS (COLMAP format)",
      "note": "Gaussian Splatting: MapAnything cameras + points written as COLMAP text for train.py."
    },
    {
      "id": "phase_4_colmap_scene",
      "progress": { "min": 50, "max": 50, "typical": 50 },
      "label": "(deprecated stage id)",
      "note": "Classic COLMAP CLI runner removed; stage id kept for older clients only."
    },
    {
      "id": "phase_5_gaussian_splatting",
      "progress": { "min": 65, "max": 95, "typical": 80 },
      "label": "Gaussian Splatting training",
      "note": "Long-running; progress stays at the emitted value until training ends."
    },
    {
      "id": "meshing",
      "progress": { "min": 75, "max": 75, "typical": 75 },
      "label": "Meshing",
      "note": "Mesh (.glb) path only: Poisson meshing."
    },
    {
      "id": "mesh_cleanup",
      "progress": { "min": 79, "max": 79, "typical": 79 },
      "label": "Mesh cleanup"
    },
    {
      "id": "shape_classification",
      "progress": { "min": 81, "max": 81, "typical": 81 },
      "label": "Object class identification"
    },
    {
      "id": "shape_template_correction",
      "progress": { "min": 84, "max": 84, "typical": 84 },
      "label": "Template-based shape correction"
    },
    {
      "id": "vertex_color_transfer",
      "progress": { "min": 85, "max": 85, "typical": 85 },
      "label": "Vertex colours from point cloud"
    },
    {
      "id": "photo_vertex_bake",
      "progress": { "min": 86, "max": 86, "typical": 86 },
      "label": "Photo-projected vertex colours"
    },
    {
      "id": "color_autobalance",
      "progress": { "min": 90, "max": 90, "typical": 90 },
      "label": "Color balancing + centering"
    },
    {
      "id": "compare_mesh_preview",
      "progress": { "min": 42, "max": 42, "typical": 42 },
      "label": "Preview mesh (MapAnything)",
      "note": "When compare_mesh_preview_with_gs and reconstruction_backend=gaussian_splatting."
    },
    {
      "id": "exporting",
      "progress": { "min": 94, "max": 94, "typical": 94 },
      "label": "Exporting model"
    },
    {
      "id": "completed",
      "progress": { "min": 100, "max": 100, "typical": 100 },
      "label": "Done"
    }
  ],
  "flows": {
    "mesh_mapanything_glb": {
      "reconstruction_backend": "mapanything",
      "order": [
        { "id": "starting", "progress": 5 },
        { "id": "phase_0_quality_filter", "progress": 8 },
        { "id": "phase_1_segmentation", "progress_range": [10, 40] },
        { "id": "phase_2_alignment", "progress": 45 },
        { "id": "phase_3_sanitization", "progress": 65 },
        { "id": "meshing", "progress": 75 },
        { "id": "mesh_cleanup", "progress": 79 },
        { "id": "shape_classification", "progress": 81 },
        { "id": "shape_template_correction", "progress": 84 },
        { "id": "vertex_color_transfer", "progress": 85 },
        { "id": "photo_vertex_bake", "progress": 86 },
        { "id": "color_autobalance", "progress": 90 },
        { "id": "exporting", "progress": 94 },
        { "id": "completed", "progress": 100 }
      ]
    },
    "gaussian_splatting": {
      "reconstruction_backend": "gaussian_splatting",
      "order": [
        { "id": "starting", "progress": 5 },
        { "id": "phase_0_quality_filter", "progress": 8 },
        { "id": "phase_1_segmentation", "progress_range": [10, 40] },
        { "id": "compare_mesh_preview", "progress": 42 },
        { "id": "phase_2_alignment", "progress": 45 },
        { "id": "phase_3_sanitization", "progress": 55 },
        { "id": "phase_4_colmap_bridge", "progress": 60 },
        { "id": "phase_5_gaussian_splatting", "progress": 65 },
        { "id": "exporting", "progress": 95 },
        { "id": "completed", "progress": 100 }
      ],
      "note": "compare_mesh_preview step emitted only when compare_mesh_preview_with_gs is true."
    }
  }
}
