APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_WORKERS=1
APP_ROOT_DIR=.
# SQLite job store (default: <APP_ROOT_DIR>/data/jobs.sqlite)
# APP_DATABASE_PATH=C:\data\polygraphics\jobs.sqlite
# Optional: separate Python interpreter to run gaussian-splatting train.py
# APP_GS_PYTHON_EXECUTABLE=C:\Users\me\miniconda3\envs\gs\python.exe
# Optional absolute base URL for job.model_url (e.g. a real CDN). When unset
# or set to a loopback URL (127.0.0.1/localhost), the API emits relative paths
# like /output/<job>.glb (no sub-path prefix; use APP_MODEL_BASE_URL for a full CDN URL)
# so the frontend resolves them on its own origin. Only set this if you serve
# the .glb/.ply files from a different host than the API.
# APP_MODEL_BASE_URL=https://cdn.example.com/models
# APP_CDN_BASE_URL=https://cdn.example.com/models
# Optional absolute base URL for job.image_sample_url. Same rules as above; when
# unset, derived from APP_MODEL_BASE_URL by swapping /output -> /uploads, falling
# back to a relative /uploads path.
# APP_UPLOADS_BASE_URL=https://cdn.example.com/uploads
# Comma-separated origins for CORS (default *). Example: http://localhost:5173
APP_CORS_ORIGINS=*
# When the API is served behind a reverse proxy under a sub-path that the proxy
# strips before forwarding (e.g. https://example.com/polygraph/* -> 127.0.0.1:8000/*),
# set the prefix here so Swagger UI builds correct URLs (/polygraph/openapi.json, etc.).
# Leave empty when there is no path prefix.
# APP_ROOT_PATH=/polygraph
