APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
APP_WORKERS=1
# Application data root: uploads/, output/, config/, data/. Leave unset to use the
# repository directory (where this project lives). Relative values are resolved from
# that directory (so "." always means the repo, not the NSSM/CWD folder).
# APP_ROOT_DIR=C:\polyGraphics\polygraphics-backend
# SQLite job store (default: <APP_ROOT_DIR>/data/jobs.sqlite)
# APP_DATABASE_PATH=C:\data\polygraphics\jobs.sqlite
# Optional: separate Python interpreter to run gaussian-splatting train.py
# APP_GS_PYTHON_EXECUTABLE=C:\Users\me\miniconda3\envs\gs\python.exe
# Optional absolute base URL for job.model_url (e.g. a real CDN). When unset
# or set to a loopback URL (127.0.0.1/localhost), the API emits relative paths
# like /output/<job>.glb (no sub-path prefix; use APP_MODEL_BASE_URL for a full CDN URL)
# so the frontend resolves them on its own origin. Only set this if you serve
# the .glb/.ply files from a different host than the API.
# APP_MODEL_BASE_URL=https://cdn.example.com/models
# APP_CDN_BASE_URL=https://cdn.example.com/models
# Optional absolute base URL for job.image_sample_url. Same rules as above; when
# unset, derived from APP_MODEL_BASE_URL by swapping /output -> /uploads, falling
# back to a relative /uploads path.
# APP_UPLOADS_BASE_URL=https://cdn.example.com/uploads
# Same public host for both (typical Nginx /polygraph/ setup):
#   APP_MODEL_BASE_URL=https://example.com/polygraph/output
#   APP_UPLOADS_BASE_URL=https://example.com/polygraph/uploads
# Nginx must proxy /output and /uploads to this app; the app only returns URL strings.
# Comma-separated origins for CORS (default *). Example: http://localhost:5173
APP_CORS_ORIGINS=*
# When the API is served behind a reverse proxy under a sub-path that the proxy
# strips before forwarding (e.g. https://example.com/polygraph/* -> 127.0.0.1:8000/*),
# set the prefix here so Swagger UI builds correct URLs (/polygraph/openapi.json, etc.).
# Leave empty when there is no path prefix.
# APP_ROOT_PATH=/polygraph

# --- Remote GPU workers (split deploy: API on CPU, ML on a worker with outbound-only network) ---
# When true, the API does not run reconstruction in-process; a worker polls GET /internal/worker/next.
# APP_REMOTE_WORKERS=true
# Shared secret; worker sends header X-Worker-Token. Generate a long random string.
# APP_WORKER_TOKEN=
# Public base URL of this API **including** APP_ROOT_PATH (no trailing slash). Required so workers can
# download inputs via absolute URLs, e.g. https://agentmanager.easymediasuitecloud.com/polygraph
# APP_PUBLIC_BASE_URL=https://agentmanager.easymediasuitecloud.com/polygraph

# Force MapAnything mesh (.glb) even when settings JSON has reconstruction_backend gaussian_splatting (skip train.py).
# POLYGRAPH_SKIP_GAUSSIAN_SPLATTING=1
