# Copy to ".env.worker" in the repo root (scripts/run_worker.ps1 loads it first).

# Must match APP_ROOT_PATH on the server — full public origin + API prefix, no trailing slash.
POLYGRAPH_API_BASE=https://agentmanager.easymediasuitecloud.com/polygraph

# Same secret as APP_WORKER_TOKEN on the API server (header X-Worker-Token).
POLYGRAPH_WORKER_TOKEN=

# Required on this GPU PC for real SAM: absolute path to Segment Anything .pth (must exist here).
# PUT /settings alone uses the API server's paths; override so the worker finds your local file.
# Example after scripts/install_ml_windows.ps1:
# POLYGRAPH_OVERRIDE_SAM_CHECKPOINT=C:\polyGraphics\models\sam\sam_vit_b_01ec64.pth

# Optional: override Hugging Face model id for MapAnything (default in settings is facebook/map-anything-apache).
# POLYGRAPH_OVERRIDE_MAPANYTHING_MODEL=facebook/map-anything-apache

# Force PyTorch device on this machine (overrides PUT /settings ``device``). If unset, worker
# uses CUDA when a GPU is available; set ``cpu`` to force CPU (e.g. debugging).
# POLYGRAPH_OVERRIDE_DEVICE=cuda

# WebSocket keepalive while **idle** (waiting for job_assigned). The worker closes the socket when a
# job starts and reconnects after it finishes — progress uses REST POST .../progress (avoids 1011 during GPU work).
# POLYGRAPH_WS_PING_INTERVAL=30
# POLYGRAPH_WS_PING_TIMEOUT=600

# WebSocket job notifications (default on). Set 0 to use HTTP polling only.
# POLYGRAPH_USE_WEBSOCKET=1

# If WebSocket returns HTTP 404, set explicit URL (no ?token= — worker appends it):
# POLYGRAPH_WEBSOCKET_URL=wss://agentmanager.easymediasuitecloud.com/polygraph/internal/worker/ws

# Also try wss://host/internal/worker/ws after a prefixed URL 404s (default 1). Set 0 to disable.
# POLYGRAPH_WS_TRY_STRIPPED=1

# Fallback: GET /internal/worker/next while WebSocket is down (see POLYGRAPH_POLL_WHILE_WEBSOCKET).
# POLYGRAPH_POLL_SECONDS=30

# When WebSocket job notifications are on (default): slow REST polling to ~max(POLL_SECONDS,180s)
# unless you set 1/true here (previous behaviour: frequent /next plus WS — more duplicate wakes / logs).
# POLYGRAPH_POLL_WHILE_WEBSOCKET=1

# Min seconds between POST /internal/worker/jobs/{id}/progress (default 5).
# POLYGRAPH_PROGRESS_INTERVAL_SECONDS=5

# If 1/true: worker refuses to start a job when CUDA is not available (strict GPU box).
# POLYGRAPH_REQUIRE_CUDA=1

# Keep per-job worker folders (including isolated SAM outputs) for manual inspection.
# When enabled, worker prints exact paths:
#   masked -> <workdir>\masked\<job_id>\masked_*.png
#   masks  -> <workdir>\masks\<job_id>\mask_*.png
# POLYGRAPH_WORKER_PRESERVE_WORKDIR=1
# Optional parent folder for those per-job dirs (default: OS temp folder).
# POLYGRAPH_WORKER_WORKDIR_ROOT=C:\polyGraphics\worker_jobs

# Helps PyTorch reclaim fragmented CUDA memory on 8 GB GPUs (recommended if you see CUDA OOM).
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# VRAM strategy (see app/cuda_memory.py): subprocess SAM + subprocess GS scene prep when ``gpu_isolate_phases``
# is true in PUT /settings (default). Set false here to disable subprocess isolation without changing API JSON:
# POLYGRAPH_GPU_ISOLATE_PHASES=0

# graphdeco-inria/gaussian-splatting clone path on GPU (when using reconstruction_backend gaussian_splatting):
# POLYGRAPH_OVERRIDE_GS_REPO=C:\polyGraphics\third_party\gaussian-splatting

# Temporary: force mesh output (.glb) even if PUT /settings has reconstruction_backend gaussian_splatting
# (skips train.py / CUDA submodules). Set on API host and/or worker — same variable on both for split deploy.
# POLYGRAPH_SKIP_GAUSSIAN_SPLATTING=1

# Train deps: build CUDA submodules into *this worker's* Python (same as gs_python_executable in settings, or the worker venv).
# Clone with submodules (`git submodule update --init --recursive`), then pip install each submodule folder.
# See scripts/install_gaussian_splatting_windows.ps1.

# Mesh tuning in PUT /settings: sam_segmentation_mode, mesh_photo_vertex_bake, MapAnything minibatch/max views, etc.
