# Copy to ".env.worker" in the repo root (scripts/run_worker.ps1 loads it first).

# Must match APP_ROOT_PATH on the server — full public origin + API prefix, no trailing slash.
POLYGRAPH_API_BASE=https://agentmanager.easymediasuitecloud.com/polygraph

# Same secret as APP_WORKER_TOKEN on the API server (header X-Worker-Token).
POLYGRAPH_WORKER_TOKEN=

# Required on this GPU PC for real SAM: absolute path to Segment Anything .pth (must exist here).
# PUT /settings alone uses the API server's paths; override so the worker finds your local file.
# Example after scripts/install_ml_windows.ps1:
# POLYGRAPH_OVERRIDE_SAM_CHECKPOINT=C:\polyGraphics\models\sam\sam_vit_b_01ec64.pth

# Force PyTorch device on this machine (overrides PUT /settings ``device``). If unset, worker
# uses CUDA when a GPU is available; set ``cpu`` to force CPU (e.g. debugging).
# POLYGRAPH_OVERRIDE_DEVICE=cuda

# Optional override for mesh_texture_mapping (PUT /settings is used if unset).
# Set 0 to skip slow phase_6 on the worker; set 1 to force UV bake for better GLB colours.
# Ignored for gaussian_splatting (.ply path). Example: POLYGRAPH_MESH_TEXTURE_MAPPING=0

# WebSocket keepalive while **idle** (waiting for job_assigned). The worker closes the socket when a
# job starts and reconnects after it finishes — progress uses REST POST .../progress (avoids 1011 during GPU work).
# POLYGRAPH_WS_PING_INTERVAL=30
# POLYGRAPH_WS_PING_TIMEOUT=600

# WebSocket job notifications (default on). Set 0 to use HTTP polling only.
# POLYGRAPH_USE_WEBSOCKET=1

# If WebSocket returns HTTP 404, set explicit URL (no ?token= — worker appends it):
# POLYGRAPH_WEBSOCKET_URL=wss://agentmanager.easymediasuitecloud.com/polygraph/internal/worker/ws

# Also try wss://host/internal/worker/ws after a prefixed URL 404s (default 1). Set 0 to disable.
# POLYGRAPH_WS_TRY_STRIPPED=1

# Fallback: poll GET /internal/worker/next if WebSocket is down (default 30).
# POLYGRAPH_POLL_SECONDS=30

# Min seconds between POST /internal/worker/jobs/{id}/progress (default 5).
# POLYGRAPH_PROGRESS_INTERVAL_SECONDS=5

# If 1/true: worker refuses to start a job when CUDA is not available (strict GPU box).
# POLYGRAPH_REQUIRE_CUDA=1

# If other checkpoint paths on this GPU PC differ from PUT /settings on the server:
# POLYGRAPH_OVERRIDE_DUST3R_CHECKPOINT=C:\polyGraphics\models\dust3r\DUSt3R_ViTLarge_BaseDecoder_224_linear.pth
# POLYGRAPH_OVERRIDE_COLMAP_PATH=C:\path\to\colmap.bat
# POLYGRAPH_OVERRIDE_DUST3R_REPO=C:\polyGraphics\third_party\dust3r

# Mesh / colour quality is mostly from PUT /settings (worker inherits mesh_texture_mapping).
# For darker or wrong GLB: mesh_texture_mapping=true, sam_segmentation_mode=auto_masks_center_bias,
# dust3r_confidence_threshold=0 or 0.2, more overlapping photos. GPU speeds SAM/DUSt3R; it does not fix bad masks.
